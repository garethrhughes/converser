# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=converser
DATABASE_PASSWORD=converser_local
DATABASE_NAME=converser

# Auth — Google OAuth 2.0
GOOGLE_CLIENT_ID=[REQUIRED]
GOOGLE_CLIENT_SECRET=[REQUIRED]
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# JWT
JWT_SECRET=[REQUIRED]
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google token encryption (32-byte hex key for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=[REQUIRED]

# Google Drive API
GOOGLE_DRIVE_ENABLED=true

# AWS Bedrock
AWS_REGION=eu-west-1
AWS_BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
AWS_BEDROCK_API_KEY=[REQUIRED]
# Generate a Bedrock API key: https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.md

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
